# GCP Project Configuration
export PROJECT_ID="your-gcp-project-id"
export DATASET_ID="pii_extraction"
export GCS_OUTPUT_BUCKET="your-extraction-output-bucket"

# Data Source (glean.drive_files)
export SOURCE_PROJECT="glean"
export SOURCE_TABLE="drive_files"
export SOURCE_TRIAGE_CATEGORY="INCL_STRUCTURED_RECORD"

# Local vLLM Configuration
export VLLM_API_BASE="http://localhost:8000"
export VLLM_MODEL="QuantTrio/Qwen3-Coder-30B-A3B-Instruct-GPTQ-Int8"
export VLLM_TIMEOUT="300"

# Phase Configuration
export PHASE1_SAMPLES_PER_SOURCE="20"
export PHASE2_TEST_SAMPLES="50"
export PHASE3_QUALITY_SAMPLE_SIZE="10000"
export PHASE3_QUALITY_THRESHOLD="0.85"

# Phase 4 Execution
export QUEUE_MODE="1"
export QUEUE_TARGET_BIN_GUIDS="15000"
export QUEUE_DB_DIR="/tmp/extraction_queues"
export MAX_WORKERS="96"

# BigQuery/GCS Settings
export BQ_MAX_RETRIES="5"
export GCS_MAX_RETRIES="3"

# Logging
export LOG_LEVEL="INFO"
# export DEBUG="false"

# Google Cloud Authentication
# Option 1: gcloud CLI (automatic)
# gcloud auth application-default login

# Option 2: Service account key file
# export GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"
